# Backend-only secrets (set these on Render, NOT on Vercel)
GEMINI_API_KEY=your_gemini_api_key
AUTH_SECRET=replace_with_a_long_random_secret
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/chologhuri

# Frontend URL (optional; the backend currently allows the production URL directly)
APP_URL=https://chologhuri.vercel.app

# Frontend API URL (set this on Vercel; Vite exposes VITE_* variables to the browser)
# VITE_API_URL=https://chologhuri-backend.onrender.com
